{
  "expo": {
    "name": "SocialApp",
    "slug": "socialapp",
    "version": "1.0.0",
    "scheme": "socialapp",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "Izinkan SocialApp mengirim notifikasi pesan masuk."
      }
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan SocialApp menggunakan kamera untuk membuat story.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan SocialApp memilih foto untuk postingan.",
          "cameraPermission": "Izinkan SocialApp menggunakan kamera."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan SocialApp mengakses lokasi untuk menampilkan pengguna sekitar."
        }
      ],
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "Izinkan SocialApp mengakses galeri foto.",
          "savePhotosPermission": "Izinkan SocialApp menyimpan foto ke galeri.",
          "granularPermissions": [
            "photo"
          ]
        }
      ]
    ]
  }
}
